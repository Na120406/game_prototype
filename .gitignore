# Godot 4+ generated files
.godot/
*.import

# AI/editor metadata and package-manager cache
.claude/
.cursor/
.pnpm-store/

# Local project instructions and development launchers
/design/
/AGENTS.md
/RULES.md
/start-deepseek-harness.bat

# Local tools, exports, and build output
/tools/
/build/
/export/
*.exe
*.pck
*.zip
*.7z

# Ignore loose files at repository root by default.
# Keep the files required to open, document, and export the Godot project.
/*.*
!/.gitignore
!/README.md
!/project.godot
!/export_presets.cfg

# Logs and temporary files
*.log
*.tmp
*.temp
*.bak

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Godot 4+ platform output
/android/
