interact={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":69,"key_label":0,"unicode":101,"location":0,"echo":false,"script":null)
]
}
# Chuột phải — dùng để TIÊU THỤ vật phẩm (consumable) trong slot đang select.
# Tách khỏi "interact" (E) để không xung đột với portal/npc/counter. Chuột
# phải cũng được farm_plot bắt để thực hiện farming actions (plow/water/
# plant/harvest) — Player CHỈ consume khi slot đang chọn là CONSUMABLE.
mouse_right={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"button_mask":0,"position":Vector2(0, 0),"global_position":Vector2(0, 0),"factor":1.0,"button_index":2,"canceled":false,"pressed_for_aiming":false,"double_click":false,"script":null)
]
}
# Chuột trái — dùng để click vào ô đất/cây trồng. farm_plot kiểm tra trạng
# thái cây (EMPTY/PLOWED/SEEDED/MATURE/WILTED) để quyết định plow/water/
# plant/harvest/show-info.
mouse_left={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"button_mask":0,"position":Vector2(0, 0),"global_position":Vector2(0, 0),"factor":1.0,"button_index":1,"canceled":false,"pressed_for_aiming":false,"double_click":false,"script":null)
]
}
