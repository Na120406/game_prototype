; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="GameDemo"
run/main_scene="res://scenes/maps/inside_house_map.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://scenes/icon.svg"

[autoload]

FarmEnums="*res://scripts/autoload/farm_enums.gd"
GameState="*res://scripts/autoload/game_state.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
CameraManager="*res://scripts/autoload/camera_manager.gd"
DialogueManager="*res://scripts/autoload/dialogue_manager.gd"
EventManager="*res://scripts/autoload/event_manager.gd"
SceneManager="*res://scripts/autoload/scene_manager.gd"
TimeManager="*res://scripts/autoload/time_manager.gd"
WeatherSystem="*res://scripts/autoload/weather_system.gd"
FamilyRegistry="*res://scripts/autoload/family_registry.gd"
NPCSchedules="*res://scripts/autoload/npc_schedules.gd"
RiskCalculator="*res://scripts/autoload/risk_calculator.gd"
ConsequenceResolver="*res://scripts/autoload/consequence_resolver.gd"
EventChainEngine="*res://scripts/autoload/event_chain_engine.gd"
WorldSimulator="*res://scripts/autoload/world_simulator.gd"
CatchUpSystem="*res://scripts/autoload/catch_up_system.gd"
QuestSystem="*res://scripts/autoload/quest_system.gd"
ItemManager="*res://scripts/autoload/item_manager.gd"
ItemDB="*res://resources/items/item_database.gd"
InteractionPromptManager="*res://scripts/autoload/interaction_prompt_manager.gd"
ItemHandler="*res://scripts/autoload/item_handler.gd"
ToolHandler="*res://scripts/autoload/tool_handler.gd"
EnergyManager="*res://scripts/autoload/energy_manager.gd"
EnergyBar="*res://scripts/ui/energy_bar.gd"
UIFocusManager="*res://scripts/autoload/ui_focus_manager.gd"
FarmTickManager="*res://scripts/autoload/farm_tick_manager.gd"
FloatingWarning="*res://scripts/autoload/floating_warning.gd"
HotkeyInputManager="*res://scripts/ui/hotkey_input_manager.gd"
InputRouter="*res://scripts/autoload/input_router.gd"

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

[input]

move_up={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":87,"key_label":0,"unicode":119,"location":0,"echo":false,"script":null)
]
}
move_down={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":83,"key_label":0,"unicode":115,"location":0,"echo":false,"script":null)
]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":65,"key_label":0,"unicode":97,"location":0,"echo":false,"script":null)
]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":68,"key_label":0,"unicode":100,"location":0,"echo":false,"script":null)
